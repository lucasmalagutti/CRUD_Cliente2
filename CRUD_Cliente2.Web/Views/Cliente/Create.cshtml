@model CRUD_Cliente2.Web.ViewModels.ClienteCreateViewModel

@{
    ViewData["Title"] = "Cadastro de Cliente";
}

<h1>Cadastro de Cliente</h1>

<form asp-action="Create" method="post">
    <fieldset>
        <legend>Dados Pessoais</legend>

        <div class="form-group">
            <label asp-for="Nome"></label>
            <input asp-for="Nome" class="form-control" />
            <span asp-validation-for="Nome" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="DataNascimento"></label>
            <input asp-for="DataNascimento" class="form-control" type="date" />
            <span asp-validation-for="DataNascimento" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="CPF"></label>
            <input asp-for="CPF" class="form-control" maxlength="11" />
            <span asp-validation-for="CPF" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Email"></label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Genero"></label>
            <select asp-for="Genero" class="form-control">
                <option value="">Selecione</option>
                <option>Masculino</option>
                <option>Feminino</option>
                <option>Outro</option>
            </select>
            <span asp-validation-for="Genero" class="text-danger"></span>
        </div>
    </fieldset>

    <fieldset>
        <legend>Telefone</legend>

        <div class="form-group">
            <label asp-for="TelefoneTipo"></label>
            <select asp-for="TelefoneTipo" class="form-control">
                <option value="">Selecione</option>
                <option>Fixo</option>
                <option>Comercial</option>
                <option>Celular</option>
            </select>
            <span asp-validation-for="TelefoneTipo" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="TelefoneDDD"></label>
            <input asp-for="TelefoneDDD" class="form-control" />
            <span asp-validation-for="TelefoneDDD" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="TelefoneNumero"></label>
            <input asp-for="TelefoneNumero" class="form-control" />
            <span asp-validation-for="TelefoneNumero" class="text-danger"></span>
        </div>
    </fieldset>

    <fieldset>
        <legend>Senha</legend>

        <div class="form-group">
            <label asp-for="Senha"></label>
            <input asp-for="Senha" class="form-control" type="password" />
            <span asp-validation-for="Senha" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="ConfirmarSenha"></label>
            <input asp-for="ConfirmarSenha" class="form-control" type="password" />
            <span asp-validation-for="ConfirmarSenha" class="text-danger"></span>
        </div>
    </fieldset>

    <fieldset>
        <legend>Endereço Residencial</legend>

        @Html.EditorFor(m => m.EnderecoResidencial)
    </fieldset>

    <fieldset>
        <legend>Endereço de Cobrança</legend>

        @Html.EditorFor(m => m.EnderecoCobranca)
    </fieldset>

    <fieldset>
        <legend>Cartão de Crédito</legend>

        <div class="form-group">
            <label asp-for="NumeroCartao"></label>
            <input asp-for="NumeroCartao" class="form-control" inputmode="numeric" />
            <span asp-validation-for="NumeroCartao" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="NomeImpresso"></label>
            <input asp-for="NomeImpresso" class="form-control" />
            <span asp-validation-for="NomeImpresso" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Bandeira"></label>
            <select asp-for="Bandeira" class="form-control">
                <option value="">Selecione a bandeira</option>
                <option>Visa</option>
                <option>Mastercard</option>
                <option>Elo</option>
                <option>Hipercard</option>
            </select>
            <span asp-validation-for="Bandeira" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="CodigoSeguranca"></label>
            <input asp-for="CodigoSeguranca" class="form-control" />
            <span asp-validation-for="CodigoSeguranca" class="text-danger"></span>
        </div>

        <div class="form-check">
            <input asp-for="Preferencial" class="form-check-input" />
            <label asp-for="Preferencial" class="form-check-label">Preferencial</label>
        </div>
    </fieldset>

    <button type="submit" class="btn btn-success mt-3">Cadastrar</button>
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
